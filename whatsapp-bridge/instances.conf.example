# Your WhatsApp accounts, one per line.
#
# Copy this file to instances.conf and edit that copy. instances.conf stays on
# your computer and is never committed, because it holds your phone numbers.
#
# Each line has four things, separated by commas:
#
#     name, port, number, "description"
#
# name         A short word you choose: personal, work, us, brasil. You type
#              this to start the account, and Claude shows it as
#              whatsapp-personal.
#
# port         Just a number. Each account needs a different one. Use 8080,
#              8081, 8082 and so on unless something else is already using them.
#
# number       The phone number for this account: country code first, digits
#              only. The account refuses to start if a different phone scans
#              the code, so a label can never point at the wrong account.
#              Leave it empty or write - to skip that check.
#
# description  In double quotes, in plain English. Claude reads this to decide
#              which account to use, so "Work number in Brazil, colleagues and
#              clients" helps it much more than "work". Commas are fine inside
#              the quotes.
#
# Spaces around the commas don't matter. Lines starting with # are ignored.

personal, 8080, 15551234567,   "My US number, family and friends"
work,     8081, 5511988887777, "Work number in Brazil, colleagues and clients"


# Where downloaded photos, PDFs and voice notes are saved.
#
# Without this they go inside this project folder, which is fine for the
# program but a bad place to find a PDF later. Point it somewhere you and
# Claude can both reach. ~/Claude is the folder Claude Desktop uses for files,
# so this is usually the right answer:

media_dir = ~/Claude/whatsapp

# Files land in media_dir/<account name>/<chat>/, so two accounts never
# overwrite each other's copy of the same file from the same person.
